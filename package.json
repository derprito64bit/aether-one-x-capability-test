{
  "name": "aether-one-x-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:quick": "playwright test --project=chromium e2e/smoke.spec.ts e2e/film.spec.ts",
    "e2e:update": "playwright test --update-snapshots",
    "analyze": "vite build && node scripts/bundle-budget.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test && npm run build && npm run analyze"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "motion": "^13.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.11.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.4"
  }
}
